using Gtk 4.0;
using Gio 2.0;
using Adw 1;

Adw.Dialog dialog {
  content-width: 920;
  content-height: 680;
  closed => $closed();

  styles [
    "termplex-workbench-dialog",
  ]

  Adw.ToolbarView {
    top-bar-style: flat;

    [top]
    Adw.HeaderBar {
      [title]
      Adw.WindowTitle {
        title: _("Workspace Dashboard");
        subtitle: _("Active workspace");
      }

      [end]
      Gtk.Button refresh_button {
        icon-name: "view-refresh-symbolic";
        tooltip-text: _("Refresh");
        clicked => $refresh_clicked();
      }
    }

    Gtk.Box {
      orientation: vertical;
      spacing: 10;
      margin-top: 12;
      margin-bottom: 12;
      margin-start: 12;
      margin-end: 12;

      Gtk.Box {
        orientation: horizontal;
        spacing: 8;

        Gtk.Button {
          label: _("Command History");
          clicked => $command_history_clicked();
        }

        Gtk.Button {
          label: _("Transcript Viewer");
          clicked => $transcript_clicked();
        }

        Gtk.Button {
          label: _("Source Control");
          clicked => $source_control_clicked();
        }

        Gtk.Button {
          label: _("Storage And History");
          clicked => $storage_clicked();
        }

        Gtk.Button {
          label: _("Diagnostics");
          clicked => $diagnostics_clicked();
        }
      }

      Gtk.Label workspace_label {
        xalign: 0;
        wrap: true;
        selectable: true;
      }

      Gtk.Label summary_label {
        xalign: 0;
        wrap: true;
        selectable: true;

        styles [
          "caption",
        ]
      }

      Gtk.Paned {
        orientation: horizontal;
        hexpand: true;
        vexpand: true;

        Gtk.Box {
          orientation: vertical;
          spacing: 8;
          width-request: 360;
          vexpand: true;

          Gtk.Box {
            orientation: horizontal;
            spacing: 6;

            Gtk.Label {
              label: _("Tasks");
              hexpand: true;
              xalign: 0;

              styles [
                "heading",
              ]
            }

            Gtk.Button {
              icon-name: "media-playback-start-symbolic";
              tooltip-text: _("Run Task");
              clicked => $run_task_clicked();
            }

            Gtk.Button {
              icon-name: "document-edit-symbolic";
              tooltip-text: _("Rename Task");
              clicked => $edit_task_clicked();
            }

            Gtk.Button {
              icon-name: "user-trash-symbolic";
              tooltip-text: _("Delete Task");
              clicked => $delete_task_clicked();
            }
          }

          Gtk.Label task_empty_label {
            label: _("No saved tasks yet");
            xalign: 0;
            wrap: true;

            styles [
              "dim-label",
            ]
          }

          Gtk.ScrolledWindow task_list_scroll {
            min-content-height: 160;
            vexpand: false;

            Gtk.ListView task_view {
              show-separators: true;
              single-click-activate: true;
              activate => $task_activated();

              model: Gtk.SingleSelection task_model {
                model: Gio.ListStore task_source {
                  item-type: typeof<$TermplexDashboardTask>;
                };
              };

              styles [
                "rich-list",
              ]

              factory: Gtk.BuilderListItemFactory {
                template Gtk.ListItem {
                  child: Gtk.Box {
                    orientation: vertical;
                    spacing: 3;
                    tooltip-text: bind template.item as <$TermplexDashboardTask>.command;

                    Gtk.Label {
                      ellipsize: end;
                      halign: start;
                      wrap: false;
                      single-line-mode: true;

                      styles [
                        "title",
                      ]

                      label: bind template.item as <$TermplexDashboardTask>.name;
                    }

                    Gtk.Label {
                      ellipsize: end;
                      halign: start;
                      wrap: false;
                      single-line-mode: true;

                      styles [
                        "subtitle",
                      ]

                      label: bind template.item as <$TermplexDashboardTask>.metadata;
                    }
                  };
                }
              };
            }
          }

          Gtk.Label {
            label: _("Recent Commands");
            xalign: 0;

            styles [
              "heading",
            ]
          }

          Gtk.Label command_empty_label {
            label: _("No recent commands yet");
            xalign: 0;
            wrap: true;

            styles [
              "dim-label",
            ]
          }

          Gtk.ScrolledWindow command_list_scroll {
            min-content-height: 240;
            vexpand: true;

            Gtk.ListView command_view {
              show-separators: true;
              single-click-activate: true;
              activate => $command_activated();

              model: Gtk.SingleSelection command_model {
                model: Gio.ListStore command_source {
                  item-type: typeof<$TermplexDashboardCommand>;
                };
              };

              styles [
                "rich-list",
              ]

              factory: Gtk.BuilderListItemFactory {
                template Gtk.ListItem {
                  child: Gtk.Box {
                    orientation: vertical;
                    spacing: 3;
                    tooltip-text: bind template.item as <$TermplexDashboardCommand>.command;

                    Gtk.Label {
                      ellipsize: end;
                      halign: start;
                      wrap: false;
                      single-line-mode: true;

                      styles [
                        "title",
                        "monospace",
                      ]

                      label: bind template.item as <$TermplexDashboardCommand>.command;
                    }

                    Gtk.Label {
                      ellipsize: end;
                      halign: start;
                      wrap: false;
                      single-line-mode: true;

                      styles [
                        "subtitle",
                      ]

                      label: bind template.item as <$TermplexDashboardCommand>.metadata;
                    }
                  };
                }
              };
            }
          }
        }

        Gtk.ScrolledWindow {
          min-content-width: 420;
          min-content-height: 420;
          vexpand: true;

          Gtk.TextView details_view {
            editable: false;
            cursor-visible: false;
            monospace: true;
            wrap-mode: word_char;
          }
        }
      }

      Gtk.Box {
        orientation: horizontal;
        spacing: 8;

        Gtk.Button {
          icon-name: "edit-copy-symbolic";
          tooltip-text: _("Copy Command");
          clicked => $copy_command_clicked();
        }

        Gtk.Button {
          icon-name: "media-playback-start-symbolic";
          tooltip-text: _("Rerun Command");
          clicked => $rerun_command_clicked();
        }

        Gtk.Button {
          icon-name: "text-x-generic-symbolic";
          tooltip-text: _("Open Command Transcript");
          clicked => $command_transcript_clicked();
        }

        Gtk.Button {
          icon-name: "list-add-symbolic";
          tooltip-text: _("Save As Task");
          clicked => $save_task_clicked();
        }
      }
    }
  }
}

    git_unstage_all = git_sub.add_parser("unstage-all", help="Unstage all source-control changes")
    git_unstage_all.add_argument("--workspace", help="Workspace name or index")
    git_commit = git_sub.add_parser("commit", help="Commit staged files")
    git_commit.add_argument("--workspace", help="Workspace name or index")
    git_commit.add_argument("--message", required=True, help="Commit message")
    git_sub.add_parser("show", help="Show the source control dialog")

    # --- storage ---
    storage = subparsers.add_parser("storage", help="Storage and history operations")
    storage_sub = storage.add_subparsers(dest="action")
    storage_sub.add_parser("status", help="Show storage and history status")
    storage_sub.add_parser("show", help="Show the storage and history dialog")
    storage_terminal = storage_sub.add_parser("clear-terminal", help="Clear one terminal's persisted history")
    storage_terminal.add_argument("--workspace", help="Workspace name or index")
    storage_terminal.add_argument("--tab", type=int, help="Tab index")
    storage_workspace = storage_sub.add_parser("clear-workspace", help="Clear one workspace's persisted history")
    storage_workspace.add_argument("--workspace", help="Workspace name or index")
    storage_project = storage_sub.add_parser("delete-project", help="Delete a project/workspace and its persisted history")
    storage_project.add_argument("--workspace", help="Workspace name or index")

    # --- dashboard ---
    dashboard = subparsers.add_parser("dashboard", help="Workspace dashboard operations")
    dashboard_sub = dashboard.add_subparsers(dest="action")
    dashboard_status = dashboard_sub.add_parser("status", help="Show workspace dashboard status")
    dashboard_status.add_argument("--workspace", help="Workspace name or index")
    dashboard_status.add_argument("--limit", type=int, default=8, help="Maximum recent commands to return")
    dashboard_sub.add_parser("show", help="Show the workspace dashboard dialog")

    # --- diagnostics ---
    diagnostics = subparsers.add_parser("diagnostics", help="Diagnostics and support bundle operations")
    diagnostics_sub = diagnostics.add_subparsers(dest="action")
    diagnostics_export = diagnostics_sub.add_parser("export", help="Export a local diagnostics bundle")
    diagnostics_export.add_argument("--output", help="Output JSON file path; defaults to XDG state diagnostics dir")

    # --- task ---
    task = subparsers.add_parser("task", help="Workspace task shortcut operations")
    task_sub = task.add_subparsers(dest="action")
    task_list = task_sub.add_parser("list", help="List workspace task shortcuts")
    task_list.add_argument("--workspace", help="Workspace name or index")
    task_list.add_argument("--limit", type=int, default=50, help="Maximum tasks to return")
    task_add = task_sub.add_parser("add", help="Add or update a workspace task shortcut")
    task_add.add_argument("--workspace", help="Workspace name or index")
    task_add.add_argument("--name", required=True, help="Task shortcut name")
    task_add.add_argument("--command", required=True, help="Command to send to the selected terminal")
    task_add.add_argument("--dir", help="Working directory metadata for the task")
    task_promote = task_sub.add_parser("promote", help="Promote a command-history row into a workspace task shortcut")
    task_promote.add_argument("--workspace", help="Workspace name or index; validates the command belongs to this workspace")
    task_promote.add_argument("--command-id", required=True, type=int, help="Command history row ID from history search")
    task_promote.add_argument("--name", required=True, help="Task shortcut name")
    task_run = task_sub.add_parser("run", help="Run a task shortcut in a terminal")
    task_run.add_argument("--workspace", help="Workspace name or index")
    task_run.add_argument("--tab", type=int, help="Tab index; defaults to the selected tab")
    task_run.add_argument("--surface", type=int, help="Surface index inside the tab")
    task_run.add_argument("--name", required=True, help="Task shortcut name")
    task_delete = task_sub.add_parser("delete", help="Delete a workspace task shortcut")
    task_delete.add_argument("--workspace", help="Workspace name or index")
    task_delete.add_argument("--name", required=True, help="Task shortcut name")

    args = parser.parse_args()

    if not args.resource:
        parser.print_help()
        sys.exit(1)

    # Build IPC method and params
    method, params = build_request(args)
    if method is None:
        parser.print_help()
        sys.exit(1)

    response = send_request(method, params, socket_path=args.socket)

    if args.human:
        print(format_human(response))
    else:
        print(json.dumps(response))

    sys.exit(0 if response.get("ok") else 1)

def parse_workspace_ref(value):
    """Parse workspace argument: try integer first, fall back to string name."""
    try:
        return int(value)
    except (ValueError, TypeError):
        return value

def build_request(args):
    """Map parsed args to (method, params) tuple."""
    resource = args.resource
    action = getattr(args, "action", None)

    if resource == "ping":
        return "system.ping", {}

    if resource == "quit":
        return "system.quit", {}

    if resource == "status":
        return "system.tree", {}

    if resource == "update":
        if action == "status":
            return "update.status", {}
        if action == "check":
            return "update.check", {}
        if action == "download":
            return "update.download", {}
        return None, None

    if resource == "history":
        if action == "show":
            return "history.show", {}
        if action == "search":
            p = {"query": args.query, "limit": args.limit}
            if args.workspace:
                p["workspace"] = parse_workspace_ref(args.workspace)
            if args.dir:
                p["dir"] = args.dir
            if args.source:
                p["source"] = args.source
            if args.exit_code is not None:
                p["exit_code"] = args.exit_code
            if args.started_after:
                p["started_after"] = args.started_after
            if args.started_before:
                p["started_before"] = args.started_before
            return "history.search", p
        if action == "transcript":
            p = {"history_id": args.history_id, "lines": args.lines}
            if args.workspace:
                p["workspace"] = parse_workspace_ref(args.workspace)
            return "history.transcript", p
        if action == "transcript-search":
            p = {"history_id": args.history_id, "query": args.query, "limit": args.limit}
            if args.workspace:
                p["workspace"] = parse_workspace_ref(args.workspace)
            return "history.transcript_search", p
        if action == "transcript-show":
            p = {}
            if args.history_id:
                p["history_id"] = args.history_id
            return "history.transcript_show", p
        return None, None

    if resource == "git":
        if action == "show":
            return "git.show", {}
        if action == "status":
            p = {}
            if args.workspace:
                p["workspace"] = parse_workspace_ref(args.workspace)
            return "git.status", p
        if action == "diff":
            p = {"path": args.path, "staged": bool(args.staged)}
            if args.workspace:
                p["workspace"] = parse_workspace_ref(args.workspace)
            return "git.diff", p
        if action == "stage":
            p = {"path": args.path}
            if args.workspace:
                p["workspace"] = parse_workspace_ref(args.workspace)
            return "git.stage", p
        if action == "stage-all":
            p = {}
            if args.workspace:
                p["workspace"] = parse_workspace_ref(args.workspace)
            return "git.stage_all", p
        if action == "unstage":
            p = {"path": args.path}
            if args.workspace:
                p["workspace"] = parse_workspace_ref(args.workspace)
            return "git.unstage", p
        if action == "unstage-all":
            p = {}
            if args.workspace:
                p["workspace"] = parse_workspace_ref(args.workspace)
            return "git.unstage_all", p
        if action == "commit":
            p = {"message": args.message}
            if args.workspace:
                p["workspace"] = parse_workspace_ref(args.workspace)
            return "git.commit", p
        return None, None

    if resource == "storage":
        if action == "status":
            return "storage.status", {}
        if action == "show":
            return "storage.show", {}
        if action == "clear-terminal":
            p = {}
            if args.workspace:
                p["workspace"] = parse_workspace_ref(args.workspace)
            if args.tab is not None:
                p["tab"] = args.tab
            return "storage.clear_terminal", p
        if action == "clear-workspace":
            p = {}
            if args.workspace:
                p["workspace"] = parse_workspace_ref(args.workspace)
            return "storage.clear_workspace", p
        if action == "delete-project":
            p = {}
            if args.workspace:
                p["workspace"] = parse_workspace_ref(args.workspace)
            return "storage.delete_project", p
        return None, None

    if resource == "dashboard":
        if action == "status":
            p = {"limit": args.limit}
            if args.workspace:
                p["workspace"] = parse_workspace_ref(args.workspace)
            return "dashboard.status", p
        if action == "show":
            return "dashboard.show", {}
        return None, None

    if resource == "diagnostics":
        if action == "export":
            p = {}
            if args.output:
                p["output"] = args.output
            return "diagnostics.export", p
        return None, None

    if resource == "task":
        if action == "list":
            p = {"limit": args.limit}
            if args.workspace:
                p["workspace"] = parse_workspace_ref(args.workspace)
            return "task.list", p
        if action == "add":
            p = {"name": args.name, "command": args.command}
            if args.workspace:
                p["workspace"] = parse_workspace_ref(args.workspace)
            if args.dir:
                p["dir"] = args.dir
            return "task.add", p
        if action == "promote":
            p = {"name": args.name, "command_id": args.command_id}
            if args.workspace:
                p["workspace"] = parse_workspace_ref(args.workspace)
            return "task.promote", p
        if action == "run":
            p = {"name": args.name}
            if args.workspace:
                p["workspace"] = parse_workspace_ref(args.workspace)
            if args.tab is not None:
                p["tab"] = args.tab
            if args.surface is not None:
                p["surface"] = args.surface
            return "task.run", p
        if action == "delete":
            p = {"name": args.name}
            if args.workspace:
                p["workspace"] = parse_workspace_ref(args.workspace)
            return "task.delete", p
        return None, None

    if resource == "workspace":
        if action == "list":
            return "workspace.list", {}
        if action == "create":
            p = {}
            if args.name:
                p["name"] = args.name
            if args.dir:
                p["dir"] = args.dir
            return "workspace.create", p
        if action == "select":
            p = {}
            if args.name:
                p["ref"] = args.name
            if args.index is not None:
                p["index"] = args.index
            return "workspace.select", p
        if action == "close":
            p = {}
            if args.name:
                p["ref"] = args.name
            if args.index is not None:
                p["index"] = args.index
            return "workspace.close", p
        if action == "rename":
            return "workspace.rename", {"name": args.name, "new_name": args.new_name}
        if action == "open-folder":
            p = {}
            if args.name:
                p["ref"] = args.name
            if args.index is not None:
                p["index"] = args.index
            return "workspace.open_folder", p
        if action == "open-vscode":
            p = {}
            if args.name:
                p["ref"] = args.name
            if args.index is not None:
                p["index"] = args.index
            return "workspace.open_vscode", p
        return None, None

    if resource == "tab":
        if action == "list":
            return "tab.list", {"workspace": parse_workspace_ref(args.workspace)}
        if action == "create":
            p = {"workspace": parse_workspace_ref(args.workspace)}
            if args.title:
                p["title"] = args.title
            if args.dir:
                p["dir"] = args.dir
            if args.command:
                p["command"] = args.command
            return "tab.create", p
        return None, None

    if resource == "surface":
        if action == "send":
            return "surface.send", {
                "workspace": parse_workspace_ref(args.workspace),
                "tab": args.tab,
                "text": args.text.replace("\\n", "\n"),
            }
        if action == "read":
            return "surface.read", {
                "workspace": parse_workspace_ref(args.workspace),
                "tab": args.tab,
                "lines": args.lines,
            }
        if action == "focus":
            p = {
                "workspace": parse_workspace_ref(args.workspace),
                "tab": args.tab,
            }
            if args.surface is not None:
                p["surface"] = args.surface
            return "surface.focus", p
        return None, None

    if resource == "agent":
        if action == "list":
            return "agent.list", {}
        if action == "register":
            return "agent.register", {
                "workspace": parse_workspace_ref(args.workspace),
                "tab": args.tab,
                "type": args.type,
                "pid": args.pid,
            }
        if action == "unregister":
            return "agent.unregister", {"pid": args.pid}
        if action == "terminate":
            p = {"pid": args.pid}
            if args.policy:
                p["policy"] = args.policy
            return "agent.terminate", p
        return None, None

    return None, None

if __name__ == "__main__":
    main()
